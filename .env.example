# Template only — copy to .env.local and put real values THERE. Never put real keys in this file.
# Use personal API keys and personal accounts only — not employer keys.

# Supabase — Project Settings → API Keys / Database (Connect → Session pooler)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# LLM
LLM_PROVIDER=openai               # anthropic | openai
ANTHROPIC_API_KEY=                # optional; only if LLM_PROVIDER=anthropic
OPENAI_API_KEY=                   # required for embeddings even when LLM_PROVIDER=anthropic
LLM_FAST_MODEL=gpt-5.4-mini       # parsing, scoring, verifying
LLM_STRONG_MODEL=gpt-5.4          # rewriting, summary, recruiter sim, interviewer
EMBEDDING_MODEL=text-embedding-3-small

# App
APP_URL=http://localhost:3000
ADMIN_EMAILS=                     # comma-separated, can view /admin
