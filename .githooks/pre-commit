#!/bin/sh
# Blocks commits that include env files or anything that looks like a secret.
fail=0

envfiles=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env' | grep -v '\.env\.example$')
if [ -n "$envfiles" ]; then
  echo "pre-commit: refusing to commit env files:"; echo "$envfiles"; fail=1
fi

pattern='sb_secret_[A-Za-z0-9_-]{10,}|sb_publishable_[A-Za-z0-9_-]{10,}|sk-(proj-|ant-)?[A-Za-z0-9_-]{20,}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|postgres(ql)?://[^:/@ ]+:[^@ ]{4,}@'
# Report file names only, never the matched value.
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  if git show ":$f" 2>/dev/null | grep -qE "$pattern"; then
    echo "pre-commit: possible secret in $f"; fail=1
  fi
done

[ $fail -eq 0 ] || { echo "Commit blocked. Remove the secret (or unstage the file) and try again."; exit 1; }
