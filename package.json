{
  "name": "resume-tailor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "VITEST_SUITE=integration vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "smoke:llm": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/llm-smoke.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "openai": "^7.32.0",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  }
